VO_V130		
ShowGfx		 Yes

BEGIN Volumetric3D
    Show		 Yes
    Shading		 No
    Smoothing		 No
    AutoUpdate		 Yes
    RenderingQuality		 2
    RenderPlanes		 No
    PlaneTranslucencyMultiplier		 10
    RenderGradientVectors		 No
    GradientVectorWidth		 1
    GradientVectorLength		 100
    GradientVectorColor		 1 1 0 1
    BEGIN Grid
        PointSize		 5
        Show		 No
        DisplayLines		 Yes
        DisplayPoints		 Yes
        LineColor		 255 255 255
        PointColor		 255 255 255
    END Grid

    BEGIN Volume
        Show		 Yes
        RenderImplicitSurfaces		 No
        RenderFilledVolume		 Yes
        ClampToMinMaxColor		 No
        BEGIN ColorTranslation
            ControlPoint		  1.0000000000000000e+04 1 0 0 0.8100000023841858
            ControlPoint		  1.1000000000000000e+05 1 0.501960813999176 0 0.6399999856948853
            ControlPoint		  2.1000000000000000e+05 1 1 0 0.3600000143051147
            ControlPoint		  3.1000000000000000e+05 0.501960813999176 1 0 0.3600000143051147
            ControlPoint		  4.1000000000000000e+05 0 1 0 0.25
            ControlPoint		  5.1000000000000000e+05 0 1 0.501960813999176 0.25
            ControlPoint		  6.1000000000000000e+05 0 1 1 0.1599999964237213
            ControlPoint		  7.0000000000000000e+05 0 0 1 0.1599999964237213
        END ColorTranslation
    END Volume

    BEGIN SatisfactionVolume
        Show		 No
        RenderImplicitSurfaces		 No
        RenderFilledVolume		 Yes
        ClampToMinMaxColor		 Yes
        BEGIN ImplicitSurfaceValues
            SurfaceValue		  0.0000000000000000e+00 1 0 0 0.7814559936523438
        END ImplicitSurfaceValues
        BEGIN ColorTranslation
            ControlPoint		 -9.9999999747524271e-07 1 0 0 0.7516890168190002
            ControlPoint		  9.9999999747524271e-07 0 0.501960813999176 0 0.7516890168190002
        END ColorTranslation
    END SatisfactionVolume

    BEGIN FillLegend
        DrawLegend		 Yes
        PositionX		 5
        PositionY		 5
        VerticalAlignment		 Top
        HorizontalAlignment		 Left
        Orientation		 HorizMinToMax
        MaxItemsPerRowCol		 10
        ColorPixelWidth		 40
        ColorPixelHeight		 30
        TextColor		 #ffffff
        BackgroundColor		 #000000
        Title		 Altitude (km)
        Format		 floating_point
        NumDecimalDigits		 0
    END FillLegend
    BEGIN SurfaceLegend
        DrawLegend		 No
        PositionX		 5
        PositionY		 5
        VerticalAlignment		 Top
        HorizontalAlignment		 Left
        Orientation		 HorizMinToMax
        MaxItemsPerRowCol		 10
        ColorPixelWidth		 30
        ColorPixelHeight		 30
        TextColor		 #ffffff
        BackgroundColor		 #000000
        Format		 floating_point
        NumDecimalDigits		 1
    END SurfaceLegend
END Volumetric3D
